{
	"compilerOptions": {
		"sourceMap": true,
		"declaration": false,
		"outDir": "./out-tsc",
		"baseUrl": "./",
		"moduleResolution": "node",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"module": "commonjs",
		"target": "es5",
		"types": ["node"],
		"paths": {
			"@shared-renderer/*": ["shared/*"],
			"@root/*": ["./*"]
		},
		"lib": ["es2021", "dom"],
	},
	"files": ["main.ts"],
	"include": ["**/auth.service.ts"],
	"exclude": ["renderer", "node_modules", "**/*.{spec,test}.ts"]
}
