{
	"name": "fortibit",
	"version": "1.1.0",
	"description": "Password manager",
	"repository": {
		"type": "git",
		"url": "https://github.com/apolgesek/fortibit.git"
	},
	"author": {
		"name": "Arkadiusz Półgęsek",
		"email": "arkadiusz.polgesek@gmail.com"
	},
	"main": "main.js",
	"private": true,
	"scripts": {
		"start": "npm-run-all -p ng:serve electron:serve",
		"build": "rimraf out-tsc && npm run electron:serve-tsc && ng build --base-href ./",
		"build:dev": "npm run build -- -c dev",
		"build:prod": "npm run build -- -c production",
		"build:e2e": "npm run build -- -c e2e",
		"ng:serve": "ng serve -c local",
		"electron": "electron",
		"copyfiles-serve": "copyfiles **/*.scpt ./out-tsc && copyfiles {package.json,product.json,workspaces.json,build/**,renderer/preload.js} ./out-tsc",
		"electron:serve-tsc": "tsc -p tsconfig.serve.json && npm exec tsc -- renderer/preload.ts --types node && npm run copyfiles-serve",
		"electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron ./out-tsc --serve --inspect=9229",
		"electron:local": "npm run build:prod && electron .",
		"electron:windows": "node release-scripts/clean.js && npm run build:prod && electron-builder build --dir && node release-scripts/package.js && makensis release-scripts/nsis/Fortibit.nsi && makensis release-scripts/nsis/Fortibit-update.nsi",
		"electron:mac": "npm run build:prod && electron-builder build --mac",
		"test": "jest",
		"e2e": "npm run build:e2e && playwright test -c e2e/playwright.config.ts e2e/",
		"lint": "ng lint",
		"rebuild-native": "node release-scripts/rebuild-native.js"
	},
	"dependencies": {
		"angular-feather": "6.5.0",
		"bindings": "1.5.0",
		"csv-parser": "3.0.0",
		"csv-stringify": "6.4.4",
		"deepmerge": "4.3.1",
		"dexie": "4.0.8",
		"dexie-export-import": "4.1.2",
		"fast-xml-parser": "4.5.0",
		"focus-trap": "6.7.3",
		"fs-extra": "10.0.0",
		"generate-password": "1.7.0",
		"is-electron": "2.2.2",
		"jsqr": "1.4.0",
		"lodash": "4.17.21",
		"module-alias": "2.2.3",
		"otpauth": "9.3.1",
		"pngjs": "7.0.0",
		"psl": "1.9.0",
		"reflect-metadata": "0.2.1",
		"rxjs": "7.8.1",
		"tslib": "^2.6.2",
		"winston": "3.17.0",
		"zone.js": "0.14.10",
		"zxcvbn": "4.4.2"
	},
	"devDependencies": {
		"@angular-builders/custom-webpack": "18.0.0",
		"@angular-devkit/build-angular": "18.2.10",
		"@angular-eslint/builder": "18.2.0",
		"@angular-eslint/eslint-plugin": "18.2.0",
		"@angular-eslint/eslint-plugin-template": "18.2.00",
		"@angular-eslint/schematics": "18.2.0",
		"@angular-eslint/template-parser": "18.2.0",
		"@angular-eslint/utils": "18.2.0",
		"@angular/animations": "18.2.10",
		"@angular/cdk": "18.2.10",
		"@angular/cli": "18.2.10",
		"@angular/common": "18.2.10",
		"@angular/compiler": "18.2.10",
		"@angular/compiler-cli": "18.2.10",
		"@angular/core": "18.2.10",
		"@angular/forms": "18.2.10",
		"@angular/language-service": "18.2.10",
		"@angular/platform-browser": "18.2.10",
		"@angular/platform-browser-dynamic": "18.2.10",
		"@angular/router": "18.2.10",
		"@eslint/js": "9.13.0",
		"@playwright/test": "1.47.0",
		"@types/css-font-loading-module": "0.0.7",
		"@types/eslint__js": "8.42.3",
		"@types/jest": "29.5.7",
		"@types/lodash": "4.17.10",
		"@types/node": "20.2.5",
		"@types/pngjs": "6.0.5",
		"@types/zxcvbn": "4.4.1",
		"angular-eslint": "18.4.0",
		"copyfiles": "2.4.1",
		"electron": "33.2.0",
		"electron-builder": "25.1.8",
		"electron-reloader": "1.2.3",
		"eslint": "9.8.0",
		"eslint-plugin-playwright": "1.6.2",
		"globals": "15.9.0",
		"jest": "29.7.0",
		"node-polyfill-webpack-plugin": "1.1.4",
		"npm-run-all": "4.1.5",
		"playwright": "1.47.0",
		"prettier": "3.3.3",
		"rimraf": "6.0.1",
		"ts-jest": "29.2.5",
		"ts-node": "10.9.2",
		"typescript": "5.4.5",
		"typescript-eslint": "8.12.2",
		"wait-on": "7.2.0",
		"webdriver-manager": "12.1.8"
	},
	"engines": {
		"node": ">=20.18.0"
	},
	"browserslist": [
		"chrome 130"
	]
}
